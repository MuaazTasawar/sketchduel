# Copy to backend/.env and fill in. NEVER commit backend/.env.

# Supabase -> Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Legacy / reserved (optional)
SECRET_KEY=change-me-to-a-long-random-string

ENVIRONMENT=development

# Comma-separated browser origins allowed in production, e.g. https://sketchduel.vercel.app
# (in development any http://localhost:<port> is allowed automatically)
ALLOWED_ORIGINS=

# ONNX model produced by scripts/train_quickdraw.py (falls back to a mock if missing)
MODEL_PATH=models/quickdraw.onnx

# Server-enforced gameplay rules
DRAWING_SECONDS=60
SUBMIT_GRACE_SECONDS=5

# Abuse protection
MAX_DRAWING_BYTES=2000000
RATE_LIMIT_PER_MINUTE=30